{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpaceLoopDomainEvents",
  "definitions": {
    "BookingCreated": {
      "type": "object",
      "required": ["event_id", "booking_id", "space_id", "seeker_id", "timestamp"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "booking_id": { "type": "string" },
        "space_id": { "type": "string" },
        "seeker_id": { "type": "string" },
        "total_amount": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "PaymentEscrowed": {
      "type": "object",
      "required": ["event_id", "escrow_id", "booking_id", "amount", "status"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "escrow_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["HELD", "RELEASED", "DISPUTED"] }
      }
    },
    "AccessCredentialIssued": {
      "type": "object",
      "required": ["booking_id", "pin_code", "valid_from", "valid_until"],
      "properties": {
        "booking_id": { "type": "string" },
        "pin_code": { "type": "string" },
        "qr_token": { "type": "string" },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" }
      }
    },
    "TrustFraudSignalDetected": {
      "type": "object",
      "required": ["target_type", "target_id", "risk_score", "flags"],
      "properties": {
        "target_type": { "type": "string", "enum": ["USER", "SPACE", "BOOKING"] },
        "target_id": { "type": "string" },
        "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
