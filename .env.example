# =============================================================================
# SpaceLoop Environment Configuration Reference (.env.example)
# Copy to .env for local development or set in your cloud provider (e.g. Render)
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime & Application Configuration
# -----------------------------------------------------------------------------
FLASK_APP=backend.run:app
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0
ENABLE_PROXY_FIX=false
NUM_PROXIES=1

# -----------------------------------------------------------------------------
# Core Security Secrets (REQUIRED in Production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Development (SQLite - auto-created in instance/spaceloop_dev.db if omitted):
DATABASE_URL=sqlite:///instance/spaceloop_dev.db

# Production (PostgreSQL on Render/AWS/GCP):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# CORS Configuration (comma-separated origins or *)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# -----------------------------------------------------------------------------
# Marketplace Domain Rules
# -----------------------------------------------------------------------------
GEOFENCE_RADIUS_METERS=50.0
ESCROW_HOLD_HOURS_AFTER_CHECKIN=24
PLATFORM_FEE_PERCENTAGE=10.0
GST_PERCENTAGE=18.0
MAX_CONTENT_LENGTH=16777216

# -----------------------------------------------------------------------------
# AI & LLM Integrations (Optional)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Email Provider (memory, resend, brevo, smtp)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=memory
EMAIL_FROM_ADDRESS=no-reply@spaceloop.in
EMAIL_FROM_NAME=SpaceLoop Marketplace
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Rate Limiting & Cache
# -----------------------------------------------------------------------------
RATELIMIT_STORAGE_URI=memory://
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Frontend Build Variables (frontend/.env)
# -----------------------------------------------------------------------------
# In unified single-service deployment, leave empty to use relative /api paths
# VITE_API_URL=
