# SpaceLoop Enterprise Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
JWT_SECRET_KEY=change-this-in-production-jwt-key

# Database Configuration
# SQLite Default: sqlite:///instance/spaceloop_dev.db
DATABASE_URL=sqlite:///instance/spaceloop_dev.db
# PostgreSQL Example: postgresql://spaceloop_user:securepassword@localhost:5432/spaceloop_prod

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# CORS Settings (comma-separated origins or *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Server & Proxy Configuration
PORT=5000
HOST=0.0.0.0
ENABLE_PROXY_FIX=false
NUM_PROXIES=1

# AI & LLM Engine Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# Email Provider Configuration (memory, resend, brevo, smtp)
EMAIL_PROVIDER=memory
RESEND_API_KEY=
BREVO_API_KEY
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Rate Limiting & Storage
RATELIMIT_STORAGE_URI=memory://

# Storage & S3 Configuration (local, s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-south-1

# External Verification APIs
DISCOM_API_KEY=
UPI_VERIFICATION_API_KEY=
