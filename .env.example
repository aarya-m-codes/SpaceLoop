# SpaceLoop Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
JWT_SECRET_KEY=change-this-in-production-jwt-key

# Database Configuration
# Development SQLite default: sqlite:///instance/spaceloop_dev.db
DATABASE_URL=sqlite:///instance/spaceloop_dev.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql://spaceloop_user:securepassword@localhost:5432/spaceloop_prod

# CORS Settings (comma-separated origins or *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Server & Proxy Configuration
PORT=5000
HOST=0.0.0.0
ENABLE_PROXY_FIX=false
NUM_PROXIES=1

# AI & LLM Engine Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# Email Provider Configuration (memory, resend, brevo, smtp)
EMAIL_PROVIDER=memory
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Rate Limiting & Storage
RATELIMIT_STORAGE_URI=memory://
